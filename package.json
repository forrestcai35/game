{
  "name": "nook",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check",
    "dev": "turbo run dev",
    "mobile:open": "pnpm --filter @nook/mobile open",
    "mobile:build": "turbo run build --filter=@nook/mobile"
  },
  "devDependencies": {
    "turbo": "2.11.10"
  }
}
