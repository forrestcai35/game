{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "check": {
      "dependsOn": [
        "^check"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@nook/mobile#build": {
      "cache": false,
      "outputs": []
    },
    "@nook/mobile#check": {
      "cache": false
    }
  }
}
